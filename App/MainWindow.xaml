<Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
<TextBlock Text="03   アイコンを設定する（必要な人だけ）" FontSize="16"/>
<TextBlock Text="作ったアイコンを、フォルダやショートカットに設定できるよ。" TextWrapping="Wrap" Margin="0,6,0,2"/>
<DockPanel Margin="0,6"><Image x:Name="ApplyPreview" Width="48" Height="48" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock x:Name="ApplyIconLabel" Text="いま設定するアイコン：02で画像を選んでね。" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
<TextBlock Text="01のチェックは、保存する画像を選ぶためのものだよ。ここでは02に表示している1枚を使います。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
<TextBlock Text="アイコンを設定する場所" Style="{StaticResource FieldLabel}"/>
<DockPanel><Button x:Name="ChooseTargetButton" DockPanel.Dock="Right" Content="アイコンを設定する場所を選ぶ"/><TextBox x:Name="TargetBox" AllowDrop="True" Margin="0,0,7,0" ToolTip="フォルダ・既存ショートカット・EXE等のパスを入力、またはドロップ"/></DockPanel>
<TextBlock x:Name="TargetKindText" Text="フォルダ・既存ショートカット・EXE等を選択／ドロップできます。" Style="{StaticResource Caption}" Margin="0,5" TextWrapping="Wrap"/>
<StackPanel x:Name="ShortcutPanel" Visibility="Collapsed">
<TextBlock Text="元ファイルは変更せず、新しいショートカットを作ります。" TextWrapping="Wrap"/>
<Expander x:Name="ShortcutSettings" Header="保存先を変更・ショートカット名を編集" Margin="0,5"><StackPanel Margin="0,5">
<TextBlock Text="新しい .lnk の保存先です。ICOの保存先とは別です。" Style="{StaticResource Caption}"/>
<ComboBox x:Name="DestinationBox" SelectedIndex="0"><ComboBoxItem Content="デスクトップ" Tag="Desktop"/><ComboBoxItem Content="対象と同じフォルダ" Tag="SameFolder"/><ComboBoxItem Content="指定フォルダ" Tag="Custom"/></ComboBox>
<DockPanel x:Name="CustomShortcutPanel" Visibility="Collapsed" Margin="0,5"><Button x:Name="ChooseOutputButton" Content="保存先を変更" DockPanel.Dock="Right"/><TextBox x:Name="OutputDirectoryBox" Margin="0,0,5,0"/></DockPanel>
<TextBlock Text="ショートカット名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ShortcutNameBox" MaxLength="100"/>
</StackPanel></Expander></StackPanel>
<Button x:Name="ApplyButton" Content="アイコンを設定" Style="{StaticResource PrimaryButton}" IsEnabled="False" HorizontalAlignment="Left" MinWidth="220" Margin="0,7,0,3"/>
<Button x:Name="ApplyMoreButton" Content="ほかの場所にも設定する" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,5,0,3"/>
<TextBlock x:Name="ApplyReason" Text="まずアイコンを保存してください。" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
<TextBlock Text="設定後にICOを移動・削除すると参照が切れます。安定したICO保管庫をおすすめします。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
<Expander Header="アイコンを設定したあとについて" Margin="0,8,0,0">
<TextBlock Text="フォルダのアイコンは、変更してもすぐに見た目が切り替わらないことがあります。&#xA;そんなときは、少し待ってみてね。&#xA;それでも変わらない場合は、デスクトップの何もないところをクリックして、F5キーで表示を更新してみてください。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
</Expander>
</StackPanel></Border>
</StackPanel></ScrollViewer>
<Grid Grid.Row="2" Margin="3,6,3,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button x:Name="CancelButton" Content="中止" DockPanel.Dock="Right" Visibility="Collapsed"/><ProgressBar x:Name="BusyIndicator" DockPanel.Dock="Right" Width="70" Height="4" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="画像を追加して、保存前に仕上がりを確認しましょう。" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
<DockPanel Grid.Row="1" Margin="0,5,0,0"><Button x:Name="OpenLocationButton" Content="アイコンが保存された場所を開く" DockPanel.Dock="Left" IsEnabled="False" FontSize="11"/><TextBlock Text="管理者権限は使いません" VerticalAlignment="Center" Margin="10,0" Style="{StaticResource Caption}"/><TextBlock x:Name="GitHubFooter" Visibility="Collapsed"><Hyperlink x:Name="GitHubLink">GitHub</Hyperlink></TextBlock></DockPanel>
</Grid>
</Grid></Window>
