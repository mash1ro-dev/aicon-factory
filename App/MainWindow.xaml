<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="あいこんふぁくとりー" Width="944" Height="752" MinWidth="900" MinHeight="728"
        WindowStartupLocation="CenterScreen" FontFamily="Yu Gothic UI, Meiryo, Segoe UI"
        FontSize="12" Foreground="#233D55" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#F5EFE6">
  <Window.Resources>
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0.85,1">
      <GradientStop Color="#F5FFFFFF" Offset="0"/>
      <GradientStop Color="#EEFDFCF9" Offset="0.04"/>
      <GradientStop Color="#ECFCFBF8" Offset="0.09"/>
      <GradientStop Color="#E9F8F5EF" Offset="0.60"/>
      <GradientStop Color="#F2FDFBF8" Offset="0.93"/>
      <GradientStop Color="#F2EDE7DD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0.15,0" EndPoint="0.7,1">
      <GradientStop Color="#FFFFFFFF" Offset="0"/>
      <GradientStop Color="#FFF7F3ED" Offset="0.35"/>
      <GradientStop Color="#FFA9A9A4" Offset="0.75"/>
      <GradientStop Color="#FFE6DED2" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="21,25,23,19"/>
      <Setter Property="Background" Value="{StaticResource GlassFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1.4"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#7F7264" BlurRadius="12" ShadowDepth="3" Opacity="0.20"/></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#29445A"/>
      <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0.12,0" EndPoint="0.6,1"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#FFF5F8F8" Offset="0.48"/><GradientStop Color="#FFDBE8EE" Offset="0.78"/><GradientStop Color="#FFF2FAFD" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1.2"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Shell" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Border x:Name="Chrome" CornerRadius="17,21,18,14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Border.Effect><DropShadowEffect Color="#71818D" BlurRadius="6" ShadowDepth="2" Opacity="0.22"/></Border.Effect>
            </Border>
            <Border Margin="3,2,3,3" CornerRadius="14,18,15,11" BorderThickness="1" BorderBrush="{StaticResource GlassEdge}" IsHitTestVisible="False"/>
            <Grid Margin="5,3,5,4" IsHitTestVisible="False">
              <Grid.RowDefinitions><RowDefinition Height="0.48*"/><RowDefinition Height="0.52*"/></Grid.RowDefinitions>
              <Border CornerRadius="12,17,8,8"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#ABFFFFFF"/><GradientStop Color="#05FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              <Border Grid.Row="1" Margin="5,0,5,0" CornerRadius="0,0,13,11" BorderThickness="0,0,0,1.5" BorderBrush="#BCDDEDF5"/>
            </Grid>
            <Ellipse Width="15" Height="3" Fill="#B7FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13,5,0,0" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F2FFFFFF"/><Setter TargetName="Chrome" Property="Background" Value="#E6F4FB"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.985" ScaleY="0.96"/></Setter.Value></Setter><Setter TargetName="Chrome" Property="Background" Value="#CEE1EB"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#3C7CA7"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.64"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#173E5E"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0.15,0" EndPoint="0.7,1"><GradientStop Color="#C9F0FF" Offset="0"/><GradientStop Color="#98D6F0" Offset="0.30"/><GradientStop Color="#6EB8DC" Offset="0.68"/><GradientStop Color="#A3DAEF" Offset="0.90"/><GradientStop Color="#D7F4FF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Droplet" RenderTransformOrigin="0.5,0.5">
            <Border x:Name="Chrome" CornerRadius="27,35,30,19" Background="{TemplateBinding Background}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.6">
              <Border.Effect><DropShadowEffect Color="#4E88A8" BlurRadius="9" ShadowDepth="4" Opacity="0.32"/></Border.Effect>
            </Border>
            <Border Margin="3,2,3,4" CornerRadius="24,31,27,16" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" IsHitTestVisible="False"/>
            <Grid Margin="7,4,8,5" IsHitTestVisible="False">
              <Grid.RowDefinitions><RowDefinition Height="0.5*"/><RowDefinition Height="0.5*"/></Grid.RowDefinitions>
              <Border CornerRadius="21,29,14,9"><Border.Background><LinearGradientBrush StartPoint="0.1,0" EndPoint="0.5,1"><GradientStop Color="#DEFFFFFF"/><GradientStop Color="#27FFFFFF" Offset="0.65"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              <Border Grid.Row="1" Margin="9,0,8,0" CornerRadius="0,0,23,14" BorderThickness="0,0,0,3" BorderBrush="#D8F3FE"/>
            </Grid>
            <Ellipse Width="24" Height="3" Fill="#70FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="21,7,0,0" IsHitTestVisible="False"/>
            <Ellipse Width="7" Height="3" Fill="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,7" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1"><GradientStop Color="#D5F3FF"/><GradientStop Color="#81C9E9" Offset="0.68"/><GradientStop Color="#E1F7FF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Droplet" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.985" ScaleY="0.95"/></Setter.Value></Setter></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#2E6791"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Droplet" Property="Opacity" Value="0.68"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="9,3"/>
      <Setter Property="Background" Value="#FFFCFDFD"/><Setter Property="Foreground" Value="#233D55"/>
      <Setter Property="BorderBrush" Value="#A5AFB7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><Grid><Border Margin="2" CornerRadius="8" BorderThickness="0,1,0,0" BorderBrush="#C4FFFFFF" IsHitTestVisible="False"/><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#3C7CA7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.60"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
        <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="9,3"/><Setter Property="Background" Value="#F8FAFB"/><Setter Property="Foreground" Value="#233D55"/><Setter Property="BorderBrush" Value="#A5AFB7"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboChrome" CornerRadius="10" Background="#F8FAFB" BorderBrush="#A5AFB7" BorderThickness="1"><Grid><Border Margin="2" CornerRadius="8" BorderBrush="#D6FFFFFF" BorderThickness="0,1,0,0"/><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#365873" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="Background" Value="#EAF5FB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Border x:Name="ComboFocus" CornerRadius="10" BorderBrush="Transparent" BorderThickness="2" IsHitTestVisible="False"/>
          <ContentPresenter Margin="9,5,29,5" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#FDFCF9" BorderBrush="#A4B0B9" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><Border.Effect><DropShadowEffect Color="#7D8790" BlurRadius="7" ShadowDepth="2" Opacity="0.18"/></Border.Effect><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="#3C7CA7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.60"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#526477"/><Setter Property="FontSize" Value="11"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#36516A"/><Setter Property="Margin" Value="1,0,0,4"/><Setter Property="FontSize" Value="11"/></Style>
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#F7FBFC"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#D9E8EE"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,8,8"/><RectangleGeometry Rect="8,8,8,8"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
  </Window.Resources>
  <Grid>
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1"><GradientStop Color="#FAF8F3"/><GradientStop Color="#FFFDF9" Offset="0.35"/><GradientStop Color="#F0E6D7" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Grid IsHitTestVisible="False" ClipToBounds="True">
      <Image Source="Assets/workspace-band.png" Height="155" VerticalAlignment="Top" Stretch="UniformToFill" Opacity="0.13"><Image.Effect><BlurEffect Radius="20"/></Image.Effect></Image>
      <Image Source="Assets/wood-band.png" Height="130" VerticalAlignment="Bottom" Stretch="UniformToFill" Opacity="0.20"><Image.Effect><BlurEffect Radius="19"/></Image.Effect></Image>
      <Border VerticalAlignment="Top" Height="130"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#14FFFFFF"/><GradientStop Color="#E6FAF8F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
    </Grid>
    <Grid Margin="18,10,18,10">
      <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="158"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <Image x:Name="BrandLogo" Source="Assets/brand-logo.png" Width="139" Height="68" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="あいこんふぁくとりー" FontSize="11" Foreground="#3B5165" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
          <TextBlock Text="好きな一枚を、いつものアイコンに。" FontSize="15" FontWeight="SemiBold" Foreground="#29445A"/>
          <TextBlock Text="画像をえらぶ → できあがりを見る → 使う場所へ" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
          <Border CornerRadius="14" Background="#BCFFFFFF" BorderBrush="#D7D5CA" BorderThickness="1" Padding="10,8" VerticalAlignment="Center" Margin="0,0,7,0">
            <StackPanel><TextBlock Text="まずは画像をいれてね" Foreground="#3B5268" FontSize="11"/><TextBlock Text="Small Icons · Big Smiles" Foreground="#72818A" FontSize="9" Margin="0,3,0,0"/></StackPanel>
          </Border>
          <Image x:Name="BrandGuide" Grid.Column="1" Source="Assets/brand-guide.png" Height="82" Width="51" Stretch="Uniform" VerticalAlignment="Bottom" Margin="0,0,0,2" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="v0.1.0" Grid.ColumnSpan="2" FontSize="9" Foreground="#82919A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0"/>
        </Grid>
      </Grid>
      <ScrollViewer x:Name="BodyScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,4,3,4">
        <Grid MinWidth="824" Width="{Binding ViewportWidth, ElementName=BodyScroller}">
          <Grid.RowDefinitions><RowDefinition Height="342"/><RowDefinition Height="10"/><RowDefinition Height="186"/></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.94*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.06*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="126"/><RowDefinition Height="10"/><RowDefinition Height="54"/><RowDefinition Height="10"/><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="01   画像をえらぶ" FontFamily="Yu Gothic UI" FontSize="14" FontWeight="Medium"/>
                <Border x:Name="DropZone" Grid.Row="1" CornerRadius="16" Background="#EEF3F5" BorderBrush="#A8B4BE" BorderThickness="1" AllowDrop="True" ToolTip="PNG / JPEG / WebP 画像をまとめてドロップ">
                  <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="SingleSourcePanel" CornerRadius="12" Background="{StaticResource Checker}" Width="108" Height="108" VerticalAlignment="Center" ClipToBounds="True">
                      <Grid><TextBlock x:Name="SourcePlaceholder" Text="＋" Foreground="#8CA5B7" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="SourcePreview" Width="100" Height="100" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                    </Border>
                                        <ScrollViewer x:Name="BatchSourcePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Width="112" Height="108">
                      <TextBlock x:Name="BatchSourceList" FontSize="10" TextWrapping="Wrap" Foreground="#36516A"/>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="ここに画像をドロップ" FontWeight="SemiBold" FontSize="12"/>
                      <TextBlock Text="PNG · JPEG · WebP" Style="{StaticResource Caption}" Margin="0,3,0,6"/>
                      <Button x:Name="ChooseImageButton" Content="画像を選ぶ" HorizontalAlignment="Left" Padding="15,5"/>
                      <TextBlock x:Name="SourceFileLabel" Text="画像はまだ選ばれていません" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="215"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid Grid.Row="3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="アイコン名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="IconNameBox" MaxLength="100" AutomationProperties.Name="アイコン名" ToolTip="保存するアイコンの名前"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="カテゴリ" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CategoryBox" SelectedIndex="0" AutomationProperties.Name="カテゴリ"><ComboBoxItem Content="AI"/><ComboBoxItem Content="Image"/><ComboBoxItem Content="Audio"/><ComboBoxItem Content="Development"/><ComboBoxItem Content="Tools"/><ComboBoxItem Content="Apps"/><ComboBoxItem Content="Other"/></ComboBox></StackPanel>
                </Grid>
                <Button x:Name="GenerateButton" Grid.Row="5" Content="アイコン化する" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                <TextBlock Grid.Row="6" Text="透過PNGがおすすめ。背景は自動で消えません。&#10;元画像は変更しません。" TextAlignment="Center" Style="{StaticResource Caption}" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="BatchResultsPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                  <TextBlock x:Name="BatchSummaryText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="画像ごとにICOを保存します"/>
                  <ListBox x:Name="BatchResultsList" Grid.Row="1" Background="#F9FCFD" BorderBrush="#C9D8DF" BorderThickness="1" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3,0,5"/></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Grid.Row="2" Text="一括モードは保存のみ。対象への適用は行いません。" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                </Grid>
                <TextBlock Text="02   できあがりを見てみよう" FontSize="14" FontWeight="Medium"/>
                <TextBlock x:Name="PreviewCaption" Grid.Row="1" Text="透過チェックと、小さいサイズもチェック" Style="{StaticResource Caption}"/>
                <Grid x:Name="SinglePreviewPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="14"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Border Width="258" Height="258" Background="{StaticResource Checker}" BorderBrush="#A5B5C0" BorderThickness="1" CornerRadius="13">
                      <Grid><TextBlock x:Name="PreviewPlaceholder" Text="ここに仕上がりが表示されます" FontSize="12" Foreground="#465D75" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Preview256" Width="256" Height="256" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Grid>
                    </Border>
                    <TextBlock Text="256 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Width="72" Height="72" Background="{StaticResource Checker}" BorderBrush="#A5B5C0" BorderThickness="1" CornerRadius="13"><Image x:Name="Preview48" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border>
                    <TextBlock Text="48 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,14"/>
                    <Border Width="58" Height="58" Background="{StaticResource Checker}" BorderBrush="#A5B5C0" BorderThickness="1" CornerRadius="11"><Image x:Name="Preview32" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border>
                    <TextBlock Text="32 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,14"/>
                    <Border Width="42" Height="42" Background="{StaticResource Checker}" BorderBrush="#A5B5C0" BorderThickness="1" CornerRadius="10"><Image x:Name="Preview16" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border>
                    <TextBlock Text="16 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="32"/><RowDefinition Height="8"/><RowDefinition Height="54"/><RowDefinition Height="8"/><RowDefinition Height="40"/></Grid.RowDefinitions>
              <DockPanel><TextBlock Text="03   どこで使う？" FontSize="14" FontWeight="Medium"/><TextBlock Text="フォルダの見た目を変更 / ファイルはショートカットを作成" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="12,2,0,0"/></DockPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="96"/><ColumnDefinition Width="8"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                <TextBlock Text="対象" VerticalAlignment="Center" FontSize="11"/><TextBox x:Name="TargetBox" Grid.Column="1" AutomationProperties.Name="適用する対象のパス" ToolTip="フォルダ・ファイル・ショートカットのパス"/>
                <Button x:Name="ChooseTargetFileButton" Grid.Column="3" Content="ファイル" Padding="10,5"/><Button x:Name="ChooseTargetFolderButton" Grid.Column="5" Content="フォルダ" Padding="10,5"/>
              </Grid>
              <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="34"/><ColumnDefinition Width="14"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="ショートカットの保存先" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="DestinationBox" SelectedIndex="0" AutomationProperties.Name="ショートカットの保存先"><ComboBoxItem Content="デスクトップ" Tag="Desktop"/><ComboBoxItem Content="対象と同じフォルダ" Tag="SameFolder"/><ComboBoxItem Content="指定フォルダ" Tag="Custom"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="指定フォルダを選んだときの保存先" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OutputDirectoryBox" IsEnabled="False" AutomationProperties.Name="指定する保存先フォルダ"/></StackPanel>
                <Button x:Name="ChooseOutputButton" Grid.Column="4" Content="…" IsEnabled="False" Margin="0,17,0,0" Padding="4" ToolTip="保存先フォルダを選ぶ" AutomationProperties.Name="保存先フォルダを選ぶ"/>
                <StackPanel Grid.Column="6"><TextBlock Text="ショートカット名（空欄なら対象名）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ShortcutNameBox" MaxLength="100" AutomationProperties.Name="ショートカット名"/></StackPanel>
              </Grid>
              <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="10"/><ColumnDefinition Width="151"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                <Button x:Name="ApplyButton" Content="対象へ適用" Background="#E2EDF3" IsEnabled="False"/>
                <Button x:Name="OpenLocationButton" Grid.Column="2" Content="保存場所を開く" IsEnabled="False"/>
                <TextBlock Grid.Column="3" Text="管理者権限は使いません" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,10,0"/>
                <Button x:Name="CancelButton" Grid.Column="4" Content="中止" Visibility="Collapsed" Padding="8,4"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="3,2,3,0"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="12"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="まずは画像をいれてね。PNG・JPEG・WebPを使えます。" Foreground="#34536B" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="BusyIndicator" Grid.Column="1" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#70B7D9" Background="#E3EBEF" VerticalAlignment="Center"/></Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="真城 @ BLUEFATHOM" FontSize="9" Foreground="#8A847A"/><TextBlock x:Name="GitHubFooter" Visibility="Collapsed" Margin="10,0,0,0" FontSize="9"><Hyperlink x:Name="GitHubLink" Foreground="#7D8C96" TextDecorations="None">GitHub</Hyperlink></TextBlock></StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
